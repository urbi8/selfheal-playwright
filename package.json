{
  "name": "selfheal-playwright",
  "version": "0.1.0",
  "description": "Self-healing Playwright UI test framework powered by LLM analysis",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "demo": "tsx demo-app/server.ts",
    "test": "npx playwright test tests/e2e/todo.spec.ts",
    "test:heal": "npx playwright test tests/e2e/healing.spec.ts",
    "test:all": "npx playwright test",
    "dashboard": "tsx src/dashboard/cli.ts",
    "dashboard:open": "tsx src/dashboard/cli.ts && open reports/dashboard.html"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@playwright/test": "^1.49.0",
    "express": "^4.21.0",
    "handlebars": "^4.7.8",
    "openai": "^4.77.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
