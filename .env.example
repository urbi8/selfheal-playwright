# LLM Provider: "openai" or "anthropic"
SELFHEAL_LLM_PROVIDER=openai

# API Keys (set the one matching your provider)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# SELFHEAL_LLM_MODEL=gpt-4o
# SELFHEAL_HEALING_ENABLED=true
# SELFHEAL_HEALING_MAX_ATTEMPTS=3
# SELFHEAL_HEALING_ENABLE_VISION=true
# SELFHEAL_STORE_PATH=.selfheal/healing.db
# SELFHEAL_DASHBOARD_OUTPUT=reports/dashboard.html
